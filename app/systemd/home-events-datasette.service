[Unit]
Description=Datasette (localhost only; reach it with scripts/dashboard.sh)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data
StartLimitIntervalSec=0

[Service]
User=homeevents
EnvironmentFile=/etc/home-events/env
Environment=PYTHONPATH=/opt/home-events/app PYTHONUNBUFFERED=1
ExecStart=/opt/home-events/venv/bin/datasette serve ${DB_PATH} -h 127.0.0.1 -p 8001 -m /opt/home-events/app/datasette/metadata.json --setting sql_time_limit_ms 5000
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
