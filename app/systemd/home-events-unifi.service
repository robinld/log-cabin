[Unit]
Description=UniFi SIEM syslog flume
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data
StartLimitIntervalSec=0

[Service]
User=homeevents
EnvironmentFile=/etc/home-events/env
Environment=PYTHONPATH=/opt/home-events/app PYTHONUNBUFFERED=1
ExecStart=/opt/home-events/venv/bin/python -m home_events.flumes.unifi
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
